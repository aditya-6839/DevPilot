# ==============================================================================
# DevPilot - Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------------------------------------------
# IDEs & Code Editors
# ------------------------------------------------------------------------------
# IntelliJ / JetBrains
.idea/
*.iml
*.iws
*.ipr
out/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Eclipse / STS
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# Sublime Text
*.sublime-workspace
*.sublime-project

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.cert
*.pfx

# ------------------------------------------------------------------------------
# Logs & Diagnostic Files
# ------------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
hs_err_pid*
replay_pid*

# ------------------------------------------------------------------------------
# Backend (Java / Spring Boot / Maven)
# ------------------------------------------------------------------------------
**/target/
target/
*.class

# Maven wrapper
!.mvn/wrapper/maven-wrapper.jar
!**/backend/.mvn/wrapper/maven-wrapper.jar


# Local Spring configuration overrides (never commit local credentials)
**/application-local.*
application-local.*

# ------------------------------------------------------------------------------
# Frontend / Client (Next.js / Node.js / React)
# ------------------------------------------------------------------------------
# Dependencies
node_modules/
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output
.next/
**/.next/
client/out/
out/

# TypeScript
*.tsbuildinfo
next-env.d.ts
**/next-env.d.ts

# Vercel
.vercel/
**/.vercel/

# Test Coverage
coverage/
**/coverage/

# ------------------------------------------------------------------------------
# Docker & Local Databases
# ------------------------------------------------------------------------------
docker/data/
postgres_data/
*.sqlite
*.sqlite3
